NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irent?schema=public

JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
DEV_AUTH_BYPASS=false

WECHAT_APPID=wx_your_app_id
WECHAT_APPSECRET=your_wechat_secret
# Use AUTH_MODE=wechat in production to enforce this allowlist.
AUTH_MODE=public
WECHAT_ALLOWED_OPENIDS=
WECHAT_OWNER_OPENIDS=
SHARED_TENANT_ID=

R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=irent-assets
R2_PUBLIC_BASE_URL=https://assets.example.com

# Used automatically when R2 is not configured. Persist this directory with a Docker volume.
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_BASE_URL=https://api.example.com/uploads
# Remove unconfirmed local-upload files after this grace period.
UPLOAD_ORPHAN_RETENTION_HOURS=24

# Local full snapshots: retain by both age and total per-tenant disk usage.
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=3
BACKUP_MAX_SIZE_MB=2048

ALLOWED_ORIGINS=*
